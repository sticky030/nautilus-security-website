<style>
:root{ --navy:#0E2235; --gold:#C79A3A; --ink:#0f0f10; --muted:#5b6168; --line:#e6e6e6; }
*{ box-sizing:border-box }
html,body{ margin:0; background:#fff; color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,Inter,Segoe UI,Helvetica,Arial,sans-serif;
  line-height:1.55 }
.page{ width:210mm; min-height:297mm; margin:0 auto; padding:18mm 16mm 16mm 16mm; }
.head{
  display:flex; align-items:center; gap:12mm; margin-bottom:10mm;
  border-bottom:2px solid var(--gold); padding-bottom:8mm;
}
.logo img{ height:22mm; display:block }
.title h1{ margin:0; font-size:23pt; letter-spacing:.2px; color:var(--navy); }
.title .sub{ margin-top:2mm; font-size:12pt; color:#222 }
.badge{
  margin-top:6mm; display:inline-block; padding:3.5mm 7mm;
  border:1.5px solid var(--gold); border-radius:999px; color:var(--gold); font-weight:600;
  font-size:10.5pt; letter-spacing:.02em;
}
.grid{ display:grid; grid-template-columns: 3fr 2fr; gap:14mm }
.section h2{ margin:0 0 4mm; font-size:13pt; color:var(--navy) }
.section{ margin:0 0 9mm }
ul{ margin:0; padding-left:6mm }
li{ margin:2mm 0 } li::marker{ color:var(--gold) }
.card{
  border:1.5px solid var(--gold); border-radius:10px; padding:8mm; background:#fff;
  box-shadow: 0 1px 0 rgba(0,0,0,.02);
}
.card h3{ margin:0 0 4mm; font-size:12.5pt; color:var(--navy) }
.card p{ margin:2mm 0 }
.qr{ margin-top:7mm; display:flex; align-items:center; gap:7mm }
.qr img{ width:36mm; height:36mm; border:1px solid var(--line); border-radius:6px }
.qr small{ color:var(--muted) }
.footer{ margin-top:12mm; padding-top:6mm; border-top:1px solid var(--line); color:var(--navy); font-size:10pt }
.footer .note{ color:#666; font-size:9.5pt; margin-top:2mm }

@media print{
  @page{ size:A4; margin:12mm }
  body{ background:#fff }
  .page{ width:auto; min-height:auto; padding:0 0 0 0; }
}
</style>
</head>
<body>
<div class="page">

